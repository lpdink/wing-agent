# ── 镜像 ──────────────────────────────────────────────────────
REGISTRY=registry.cn-hangzhou.aliyuncs.com/8bitpd
TAG=develop

# ── 钉钉应用（企业内部应用，Stream 模式）─────────────────────
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 白名单：staff_id 或昵称，逗号分隔；留空 = 放行所有人（不建议）
DINGTALK_ALLOWED_USERS=

# ── Wing Gateway 鉴权（自行生成两把 key）─────────────────────
# admin：钉钉前端用（建 session / 发消息 / 注册 SendFile 工具）
WING_ADMIN_KEY=change-me-admin
# tool_runtime：devbox 工具宿主专用
WING_TOOL_KEY=change-me-tool

# ── LLM 网关（wing-ai-proxy）─────────────────────────────────
# 与 deploy/proxy/config.yaml 的 virtual_api_keys 保持一致
PROXY_API_KEY=sk-change-me

# ── Agent ────────────────────────────────────────────────────
# 默认模型（走 proxy 的 OpenAI 兼容协议）
DEFAULT_MODEL=deepseek-v4-flash-0731
# 会话工作目录（devbox 内路径，持久卷）
WING_WORKSPACE=/workspace/wing-agent

# ── devbox：git 身份与 GitHub 凭据（Agent 提交/建 PR 用）─────
GIT_USER_NAME=
GIT_USER_EMAIL=
GITHUB_TOKEN=
# 工作仓库（默认 lpdink/wing-agent）
WING_REPO=lpdink/wing-agent
