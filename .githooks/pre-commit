#!/bin/bash
set -e

echo "🎨 执行代码格式化..."
if make fmt; then
    echo "✅ 格式化完成"
    # 重新暂被格式化的文件
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
    if [ -n "$STAGED_FILES" ]; then
        echo "$STAGED_FILES" | xargs git add
    fi
else
    echo "❌ 格式化失败"
    exit 1
fi

echo ""
echo "🔍 执行代码检查..."
if make check; then
    echo "✅ 所有检查通过"
else
    echo "❌ 检查失败"
    exit 1
fi
