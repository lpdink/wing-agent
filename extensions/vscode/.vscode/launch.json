{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wing Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "sourceMaps": true,
      "presentation": {
        "hidden": false,
        "group": "wing"
      }
    }
  ]
}
